{% extends "base.html.j2" %}
{% from "macros.html.j2" import quote_row %}
{% block title %}Infos du jour — {{ date_long }}{% endblock %}
{% block body %}
<header class="topbar wrap">
  <p class="date">{{ date_long }}</p>
  <h1>{{ greeting }} ☕</h1>
</header>

<main class="wrap">
  <section class="brief" aria-label="Résumé du jour">
    <p class="lead">Voici l'essentiel des dernières 24h, en {{ reading_minutes }} min de lecture.</p>
    <div class="stats">
      <div class="stat"><b>{{ total_stories }}</b><span>sujets</span></div>
      <div class="stat"><b>{{ total_articles }}</b><span>articles lus</span></div>
      <div class="stat"><b>{{ total_sources }}</b><span>sources</span></div>
      <div class="stat"><b>{{ generated_at }}</b><span>mise à jour</span></div>
    </div>
  </section>

  {% if headlines %}
  <div class="section-title"><h2>À la une</h2></div>
  <div class="rail">
    {% for d, s in headlines %}
    <a class="headline" href="{{ d.id }}.html#{{ s.anchor }}" style="--accent: {{ d.color }}">
      <span class="label">{{ d.emoji }} {{ d.short }}</span>
      <h3>{{ s.title }}</h3>
      <p>{{ s.summary }}</p>
      <span class="src">{{ s.sources|join(" · ") }}</span>
    </a>
    {% endfor %}
  </div>
  {% endif %}

  <div class="section-title"><h2>Catégories</h2></div>
  <div class="tiles">
    {% for d in digests %}
    <a class="tile" href="{{ d.id }}.html" style="--accent: {{ d.color }}">
      <div class="tile-head">
        <span class="icon" aria-hidden="true">{{ d.emoji }}</span>
        <div><h3>{{ d.title }}</h3><p class="tagline">{{ d.tagline }}</p></div>
        <span class="count" data-unread="{% for s in d.stories %}{{ s.anchor }}{{ ' ' if not loop.last }}{% endfor %}">{{ d.stories|length }} sujet{{ 's' if d.stories|length > 1 }}</span>
      </div>
      {% if d.stories %}
      <ul>{% for s in d.stories[:3] %}<li>{{ s.title }}</li>{% endfor %}</ul>
      <span class="more">Lire la rubrique →</span>
      {% else %}
      <p class="empty">Rien de nouveau aujourd'hui.</p>
      {% endif %}
    </a>
    {% endfor %}
  </div>

  {% if quotes %}
  <div class="section-title"><h2>Marchés</h2><a href="tech.html#marches">Tout voir →</a></div>
  <div class="market">
    {% for q in quotes[:5] %}{{ quote_row(q) }}{% endfor %}
  </div>
  {% endif %}

  <footer class="note">
    {% if any_ai %}Résumés rédigés automatiquement par IA à partir des titres et chapôs des articles : vérifie les détails importants via les liens.
    {% else %}Résumés = chapô fourni par chaque journal (pas de clé IA configurée).{% endif %}
    Cours Yahoo Finance, potentiellement différés.
  </footer>
</main>
{% endblock %}
