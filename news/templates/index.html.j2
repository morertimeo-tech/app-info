<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Infos du jour — {{ date_long }}</title>
<meta name="theme-color" content="#0f172a">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="icon.svg">
<meta name="apple-mobile-web-app-capable" content="yes">
<style>
:root {
  --bg: #f6f7f9; --card: #ffffff; --text: #111827; --muted: #6b7280; --line: #e5e7eb;
  --accent: #2563eb; --chip: #eef2ff; --up: #059669; --down: #dc2626;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #0b1120; --card: #131c2e; --text: #e5e7eb; --muted: #94a3b8; --line: #1f2a40;
          --accent: #60a5fa; --chip: #1e293b; --up: #34d399; --down: #f87171; }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
       font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
header { padding: 20px 16px 8px; max-width: 760px; margin: 0 auto; }
header h1 { margin: 0; font-size: 1.6rem; }
header p { margin: 4px 0 0; color: var(--muted); font-size: .9rem; }
nav { position: sticky; top: 0; z-index: 5; background: var(--bg); border-bottom: 1px solid var(--line); }
nav .inner { max-width: 760px; margin: 0 auto; display: flex; gap: 8px; overflow-x: auto; padding: 10px 16px; scrollbar-width: none; }
nav a { flex: none; text-decoration: none; color: var(--text); background: var(--chip);
        padding: 6px 12px; border-radius: 999px; font-size: .9rem; white-space: nowrap; }
main { max-width: 760px; margin: 0 auto; padding: 8px 16px 48px; }
section { scroll-margin-top: 60px; margin-top: 24px; }
section > h2 { font-size: 1.25rem; margin: 0 0 4px; }
.overview { color: var(--muted); margin: 0 0 12px; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; margin-bottom: 12px; }
.card h3 { margin: 0 0 6px; font-size: 1.05rem; line-height: 1.35; }
.card p { margin: 0 0 8px; }
.meta { display: flex; flex-wrap: wrap; gap: 6px; font-size: .78rem; color: var(--muted); }
.meta span { background: var(--chip); padding: 2px 8px; border-radius: 999px; }
details { margin-top: 8px; }
summary { cursor: pointer; color: var(--accent); font-size: .9rem; }
details ul { margin: 8px 0 0; padding-left: 18px; }
details li { margin-bottom: 6px; font-size: .92rem; }
details li a { color: var(--accent); }
details li small { color: var(--muted); }
.empty { color: var(--muted); font-style: italic; }
.stocks { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; margin-bottom: 16px; }
.stock { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; text-decoration: none; color: var(--text); display: block; }
.stock .name { font-size: .85rem; color: var(--muted); }
.stock .price { font-weight: 600; font-variant-numeric: tabular-nums; }
.stock .chg { font-size: .85rem; font-variant-numeric: tabular-nums; }
.up { color: var(--up); } .down { color: var(--down); }
.stock svg { width: 100%; height: 28px; display: block; margin-top: 4px; }
footer { max-width: 760px; margin: 0 auto; padding: 0 16px 32px; color: var(--muted); font-size: .8rem; }
</style>
</head>
<body>
<header>
  <h1>☕ Infos du jour</h1>
  <p>{{ date_long }} · articles des dernières 24h · généré à {{ generated_at }}</p>
</header>
<nav><div class="inner">
  {% for d in digests %}<a href="#{{ d.id }}">{{ d.emoji }} {{ d.title }}</a>{% endfor %}
</div></nav>
<main>
{% for d in digests %}
<section id="{{ d.id }}">
  <h2>{{ d.emoji }} {{ d.title }}</h2>
  <p class="overview">{{ d.overview }}</p>

  {% if d.id == "tech" and quotes %}
  <div class="stocks">
    {% for q in quotes %}
    <a class="stock" href="{{ q.link }}" target="_blank" rel="noopener">
      <div class="name">{{ q.name }}</div>
      <div class="price">{{ "%.2f"|format(q.price) }} {{ q.currency }}</div>
      <div class="chg">
        <span class="{{ 'up' if q.change_1d >= 0 else 'down' }}">{{ "%+.2f"|format(q.change_1d) }}% 1j</span>
        {% if q.change_1m is not none %} · <span class="{{ 'up' if q.change_1m >= 0 else 'down' }}">{{ "%+.1f"|format(q.change_1m) }}% 1m</span>{% endif %}
      </div>
      {% if q.spark %}<svg viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
        <polyline fill="none" stroke="currentColor" stroke-width="1.5" class="{{ 'up' if (q.change_1m or 0) >= 0 else 'down' }}" points="{{ q.spark }}"/></svg>{% endif %}
    </a>
    {% endfor %}
  </div>
  {% endif %}

  {% for s in d.stories %}
  <article class="card">
    <h3>{{ s.title }}</h3>
    <p>{{ s.summary }}</p>
    <div class="meta">{% for src in s.sources %}<span>{{ src }}</span>{% endfor %}</div>
    <details>
      <summary>Voir {{ s.articles|length }} article{{ 's' if s.articles|length > 1 }}</summary>
      <ul>
        {% for a in s.articles %}
        <li><a href="{{ a.link }}" target="_blank" rel="noopener">{{ a.title }}</a><br>
          <small>{{ a.source }} · {{ a.local_time }}</small></li>
        {% endfor %}
      </ul>
    </details>
  </article>
  {% else %}
  <p class="empty">Rien de nouveau dans cette rubrique.</p>
  {% endfor %}
</section>
{% endfor %}
</main>
<footer>
  {% if any_ai %}Résumés rédigés automatiquement par IA à partir des articles : vérifie les détails importants via les liens.
  {% else %}Résumés = chapô fourni par chaque journal (aucune clé IA configurée).{% endif %}
  Cours via Yahoo Finance, potentiellement différés.
</footer>
</body>
</html>
