<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Infos du jour</title>
<meta name="description" content="Ta revue de presse quotidienne : politique, gaming, Minecraft & Valorant, tech et bourse.">
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#f2f2f7" media="(prefers-color-scheme: light)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Infos">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="icon-180.png">
<link rel="stylesheet" href="style.css?v={{ version }}">
</head>
<body>
<div id="app">
  <header class="navbar" id="navbar">
    <div class="navbar-inner"><span class="navbar-title" id="navbar-title"></span></div>
  </header>

  <main id="view" tabindex="-1"></main>

  <nav class="tabbar" aria-label="Navigation">
    <a href="#/" data-tab="today">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8M15 18h-5M10 6h8v4h-8z"/></svg>
      <span>Aujourd'hui</span>
    </a>
    <a href="#/rubriques" data-tab="rubriques">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
      <span>Rubriques</span>
    </a>
    <a href="#/marches" data-tab="marches">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 7 13.5 15.5 8.5 10.5 2 17"/><path d="M16 7h6v6"/></svg>
      <span>Marchés</span>
    </a>
    <a href="#/enregistres" data-tab="enregistres">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
      <span>Enregistrés</span>
    </a>
  </nav>

  <div class="backdrop" id="backdrop" hidden></div>
  <section class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title" hidden>
    <div class="sheet-grabber" id="sheet-grabber"><span></span></div>
    <div class="sheet-body" id="sheet-body"></div>
  </section>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</div>

<noscript><p style="padding:24px">Active JavaScript pour afficher tes infos du jour.</p></noscript>
<script id="data" type="application/json">{{ data_json|safe }}</script>
<script src="app.js?v={{ version }}"></script>
</body>
</html>
