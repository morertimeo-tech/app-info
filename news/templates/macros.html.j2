{% macro quote_row(q) -%}
<a class="quote" href="{{ q.link }}" target="_blank" rel="noopener">
  <span class="name">{{ q.name }}<span class="sym">{{ q.symbol }}</span></span>
  {% if q.spark %}<svg viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
    <polyline class="spark {{ 'up' if (q.change_1m or 0) >= 0 else 'down' }}" fill="none" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke" points="{{ q.spark }}"/></svg>{% else %}<span></span>{% endif %}
  <span class="num">
    <span class="price">{{ q.price_fmt }}</span><br>
    <span class="pill {{ 'up' if q.change_1d >= 0 else 'down' }}">{{ q.change_1d|pct }}</span>
    {% if q.change_1m is not none %}<span class="sub">{{ q.change_1m|pct(1) }} sur 1 mois</span>{% endif %}
  </span>
</a>
{%- endmacro %}
